PORT=4000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB=domigen
JWT_SECRET=replace-with-a-long-random-secret

# Exact origins, no trailing slash. Required for Stripe redirects.
FRONTEND_URL=https://your-public-site.example.com
ADMIN_URL=https://your-admin-site.example.com

# Local development only. Keep false in production.
ALLOW_ALL_ORIGINS=false

# Stripe test keys (pk_test_... / sk_test_...). Webhook secret is optional.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

CHECKOUT_SUCCESS_PATH=/checkout/success
CHECKOUT_CANCEL_PATH=/checkout/cancel

# Email delivery for member password resets. Use an SMTP provider such as
# Gmail App Passwords, Brevo, Resend SMTP, or your own mail server.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@your-domain.example.com
RESET_TOKEN_TTL_MINUTES=30
