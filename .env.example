# Backend / API
PORT=4000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/domigen?retryWrites=true&w=majority
MONGODB_DB=domigen
JWT_SECRET=replace-with-a-long-random-secret

# Public URLs used for CORS and Stripe redirects
FRONTEND_URL=https://your-public-site.example.com
ADMIN_URL=https://your-admin-site.example.com

# Local development only. Keep false in production.
ALLOW_ALL_ORIGINS=false

# Stripe — use test keys first, then live keys after launch
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# These must match the public site routes
CHECKOUT_SUCCESS_PATH=/checkout/success
CHECKOUT_CANCEL_PATH=/checkout/cancel
